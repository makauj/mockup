DATABASE_URL=postgresql://username:password@localhost:5432/your_database
API_BEARER_TOKEN=change-me
API_BEARER_SUBJECT=service_account
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Optional: use hash instead of AUTH_PASSWORD (from passlib bcrypt)
# AUTH_PASSWORD_HASH=$2b$12$...
JWT_SECRET_KEY=change-me-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
